{
    "name": "zofe/demo-module",
    "description": "Demo CRUD module for rapyd-admin v2 \u2014 self-documenting articles/authors example",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Felice Ostuni",
            "email": "felice.ostuni@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/config": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "livewire/livewire": "^4.0",
        "zofe/rapyd-admin": "dev-main|^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Modules\\Demo\\": "./"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\Modules\\Demo\\DemoModuleServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
